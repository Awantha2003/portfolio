{
  "headers": [
    {
      "source": "/admin",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api/|google.*\\.html$|robots\\.txt$|sitemap\\.xml$|llms\\.txt$|site\\.webmanifest$|.*\\.(?:jpg|jpeg|png|mp4|css|js|ico)$).*)",
      "destination": "/index.html"
    }
  ]
}
