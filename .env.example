# Copy this file to .env.local for local development, and add the same variables in
# Vercel → Project → Settings → Environment Variables for production. Never commit real values.

# Neon → your project → Connection Details → connection string
DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# Admin login. Prefer the hash: run `node scripts/hash-password.mjs "your-password"` and paste the output.
# If ADMIN_PASSWORD_HASH is set, ADMIN_PASSWORD is ignored.
ADMIN_PASSWORD_HASH=
ADMIN_PASSWORD=change-me

# Random string, at least 32 characters, used to sign the admin login cookie.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string

# Cloudinary → Dashboard → API environment variable (or set the three CLOUDINARY_* variables instead)
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# Optional
SITE_URL=https://awantha-imesh-portfolio.vercel.app
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
