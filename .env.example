# Copy this file to .env.local for local development, and add the same variables in
# Vercel → Project → Settings → Environment Variables for production.

# Neon → your project → Connection Details → connection string
DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# Password for /admin. Use a long one.
ADMIN_PASSWORD=change-me

# Random string used to sign the admin login cookie (at least 32 characters).
SESSION_SECRET=replace-with-a-long-random-string

# Cloudinary → Dashboard → API environment variable
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
